---
import { Image } from 'astro:assets';
import '../styles/contact.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import collaboration from '../assets/about-collaboration.webp';
---
<BaseLayout title="Contact Us" description="Tell JoomDev about your project and book a consultation for web, app, and business systems development." immersive>
  <div class="contact-page">
    <div class="project-intake">
      <div class="wrap-wide intake-grid">
        <header class="intro">
          <p class="eyebrow">Start a Project</p>
          <h1>What Are You <em>Building Next?</em></h1>
          <p class="type-lead">A new website, a better app, or a workflow that’s outgrown spreadsheets. Tell us what you need, and we’ll talk through the right next step.</p>
        </header>

        <section class="form-panel" aria-labelledby="form-title">
          <header class="form-heading">
            <h2 id="form-title">Share Your Project Details</h2>
            <p>Include what you want to achieve, the tools you use today, and any deadline you’re working toward.</p>
          </header>
          <ContactForm />
        </section>

        <figure class="client-proof">
          <Image src={collaboration} alt="" widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 36rem" />
          <figcaption>
            <blockquote>“…from the very first moment we met them, we knew that our search was over.”</blockquote>
            <p><strong>Alex Shvarts</strong><span>FundKite</span></p>
          </figcaption>
        </figure>
      </div>
      <ul class="wrap-wide trust-points" aria-label="JoomDev in numbers">
        <li><strong>120+</strong><span>Businesses Supported</span></li>
        <li><strong>100+</strong><span>Clients Served</span></li>
        <li><strong>5+</strong><span>Countries Served</span></li>
      </ul>
    </div>

    <section class="contact-details" aria-labelledby="details-title">
      <div class="wrap-wide details-grid">
        <div class="contact-guide">
          <h2 id="details-title">What Happens Next</h2>
          <p>We typically reply in under four hours during business hours. Submit the form to schedule a Zoom call with our team.</p>
          <div class="office-hours">
            <h3>Office Hours</h3>
            <dl>
              <div><dt>Monday–Friday</dt><dd>9 a.m.–6 p.m. EST</dd></div>
              <div><dt>Saturday–Sunday</dt><dd>Closed</dd></div>
            </dl>
          </div>
        </div>
        <div class="office-card">
          <h3>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
            Head Office
          </h3>
          <address>
            Suite 108, Vishwa Sadan<br />
            Janakpuri District Center<br />
            New Delhi, Delhi 110058, India
          </address>
          <ul aria-label="General enquiries">
            <li><a href="mailto:info@joomdev.com">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
              <span><strong>Email</strong>info@joomdev.com</span>
            </a></li>
            <li><a href="tel:+18662761994">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a13 13 0 0 1-7-7l2-2-2-5Z" /></svg>
              <span><strong>Phone</strong>+1 (866) 276-1994</span>
            </a></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="contact-faq" aria-labelledby="faq-title">
      <div class="wrap-wide details-grid">
        <header>
          <h2 id="faq-title">Planning Your Project</h2>
          <p>What to share with us and what we’ll cover on your first call.</p>
        </header>
        <div class="faq-list">
          <details open>
            <summary>Do I Need a Project Brief?</summary>
            <p>A short description is enough to get started. Tell us what’s working today, what needs to improve, and what a good outcome would look like.</p>
          </details>
          <details open>
            <summary>Can You Work With Our Existing Website or Tools?</summary>
            <p>Yes. Share the platforms you use and where you’re running into problems. That gives us a starting point for discussing what to keep, improve, or connect.</p>
          </details>
          <details open>
            <summary>What Will We Cover on a Zoom Call?</summary>
            <p>We’ll discuss your goals, review the systems involved, and talk through the scope, timing, and next steps for your project.</p>
          </details>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
