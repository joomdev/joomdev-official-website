---
import { sitePath } from '../utils/site-path';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSections from '../components/HomeSections.astro';
import artwork from '../assets/hero-art.png';
const clients = [
  { name: 'Orion High School', file: 'orion.png', width: 215, height: 50 },
  { name: 'Build It Green', file: 'build-it-green.png', width: 153, height: 50 },
  { name: 'Infinity Energy', file: 'newutility.png', width: 400, height: 130 },
  { name: 'Surv', file: 'wesurv.svg', width: 126, height: 36 },
  { name: 'FundKite', file: 'fundkite.svg', width: 301, height: 60 },
  { name: 'Boston Vitality', file: 'boston.png', width: 1025, height: 86 },
];
---
<BaseLayout title="Web Design, App Development and Business Systems" description="JoomDev designs and develops websites, apps, and connected business systems." immersive>
  <section class="hero" aria-labelledby="hero-heading" data-hero>
    <header class="hero-nav">
      <a class="brand" href={sitePath('/')} aria-label="JoomDev home"><img src={sitePath('/joomdev-logo.svg')} width="196" height="50" alt="JoomDev" /></a>
      <nav aria-label="Primary">
        <a href={sitePath('/services/')}>Services</a>
        <a href={sitePath('/services/ai-integration/')}>Integrations</a>
      </nav>
      <a class="button primary nav-cta" href={sitePath('/contact/')}>Let’s talk <span aria-hidden="true">↗</span></a>
    </header>
    <div class="hero-copy">
      <h1 id="hero-heading">Websites and apps. <em>Built to work together.</em></h1>
      <p>Launch a new site or app, then connect it to your CRM, workflows, and AI tools.</p>
      <div class="actions">
        <a class="button primary" href={sitePath('/contact/')}>Talk to our team <span aria-hidden="true">↗</span></a>
        <a class="button secondary" href={sitePath('/services/')}>Explore our services</a>
      </div>
      <nav class="service-links" aria-label="Explore by project type">
        <a href={sitePath('/services/#web')}>Web &amp; ecommerce</a>
        <a href={sitePath('/services/#apps')}>App development</a>
        <a href={sitePath('/services/#systems')}>CRM, AI &amp; automation</a>
      </nav>
    </div>
    <div class="art" aria-hidden="true">
      <div class="art-image">
        <Image src={artwork} alt="" widths={[640, 960, 1536]} sizes="(max-width: 1280px) 100vw, 1280px" format="webp" quality={80} loading="eager" fetchpriority="high" />
      </div>
      <div class="light"></div>
    </div>
  </section>
  <section class="client-proof" aria-labelledby="client-proof-heading">
    <div class="proof-inner">
      <div class="proof-heading">
        <h2 id="client-proof-heading">Trusted by <em>120+ businesses</em> across industries &amp; platforms</h2>
        <a href="https://www.joomdev.com/case-studies/">See our work <span aria-hidden="true">↗</span></a>
      </div>
      <div class="client-marquee" id="client-logos" tabindex="0" role="region" aria-label="Client logos">
        <div class="client-track">
          {[false, true].map((duplicate) => (
            <ul class="client-list" aria-hidden={duplicate ? 'true' : undefined}>
              {clients.map(({ name, file, width, height }) => (
                <li><img src={sitePath(`/clients/${file}`)} alt={duplicate ? '' : name} width={width} height={height} loading="lazy" /></li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>
  </section>
  <HomeSections />
</BaseLayout>

<style>
  :global(main.immersive) { padding: 0; }
  .hero { position: relative; isolation: isolate; overflow: hidden; background: #050b19; color: #f7f4ef; }
  .hero-nav { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; max-width: 70rem; width: calc(100% - 2rem); margin: clamp(.8rem, 2.2vw, 2rem) auto 0; padding: .55rem .65rem .55rem .8rem; border: 1px solid #385578; border-radius: 5rem; background: #080f1fee; }
  nav { justify-content: center; gap: clamp(.8rem, 3vw, 2rem); }
  nav a, .button { color: inherit; text-decoration: none; }
  nav a:hover { color: #b6ddff; }
  .brand { display: flex; justify-self: start; padding: .36rem .65rem; border-radius: 4rem; background: #f7f4ef; }
  .brand img { width: clamp(100px, 12vw, 160px); height: auto; display: block; }
  .button { display: inline-flex; justify-content: center; align-items: center; gap: .55rem; padding: .7rem 1.35rem; border: 1px solid transparent; border-radius: 4rem; font-weight: 600; transition: background-color .2s, border-color .2s; }
  .primary { background: #163df5; }
  .primary:hover { background: #2449f5; }
  .secondary { border-color: #80a8cb; background: #050b1970; }
  .secondary:hover { background: #152949; }
  .nav-cta { justify-self: end; white-space: nowrap; }
  a:focus-visible { outline: 2px solid #b6ddff; outline-offset: 4px; }
  .hero-copy { position: relative; z-index: 1; width: min(75rem, calc(100% - 2rem)); margin-inline: auto; padding-top: clamp(2.2rem, 4.5vh, 3.5rem); text-align: center; }
  h1 { max-width: none; font-size: clamp(2.6rem, min(6.4vw, 10.7vh), 6rem); font-weight: 420; letter-spacing: -.07em; line-height: .97; margin: 0; }
  h1 em { display: block; margin-top: .03em; font-family: Georgia, serif; font-weight: 400; color: #b5ddff; letter-spacing: -.065em; }
  p { max-width: 50rem; margin: 1.1rem auto; font-size: clamp(1rem, 1.65vw, 1.35rem); color: #dce3f0; }
  .actions { display: flex; justify-content: center; gap: .75rem; flex-wrap: wrap; }
  .service-links { margin-top: 1rem; gap: .4rem .55rem; font-size: .8125rem; }
  .service-links a { padding: .5rem .8rem; color: #c7d9ef; border: 1px solid #a2c8f12e; border-radius: 2rem; background: #0a1425; text-decoration: none; }
  .service-links a:hover { color: #fff; border-color: #7dace3; background: #122540; }
  .art { position: relative; width: min(100%, 80rem); height: clamp(14rem, 29vw, 26rem); margin: -.45rem auto 0; pointer-events: none; overflow: hidden; }
  .art-image, .light { position: absolute; inset: 0; }
  .art img { width: 100%; height: 100%; object-fit: cover; object-position: center 85%; mask-image: radial-gradient(ellipse 53% 71% at 50% 53%, #000 46%, transparent 99%); display: block; }
  .light { inset: 16% -35% 0; opacity: 0; mix-blend-mode: screen; background: linear-gradient(112deg, transparent 43%, #81c5ff20 50%, transparent 56%); }
  .client-proof { background: #f6f8fc; border-bottom: 1px solid #dce4f0; }
  .proof-inner { width: min(70rem, calc(100% - 2rem)); margin-inline: auto; padding-block: clamp(1.8rem, 4vw, 3.3rem); }
  .proof-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: .6rem 1.25rem; margin-bottom: 1.5rem; }
  .proof-heading h2 { margin: 0; font-size: clamp(1rem, 1.8vw, 1.375rem); letter-spacing: -.045em; color: #131e34; text-wrap: balance; }
  .proof-heading h2 em { color: #163da3; font-style: normal; }
  .proof-heading a { font-size: .88rem; font-weight: 650; text-underline-offset: .25em; }
  .client-marquee { overflow-x: auto; }
  .client-track { display: flex; width: max-content; }
  .client-list { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; }
  .client-list[aria-hidden="true"] { display: none; }
  .client-list li { display: grid; place-items: center; width: clamp(8.5rem, 15.5vw, 12rem); min-height: 4.2rem; padding-inline: .8rem; box-sizing: border-box; }
  .client-list img { filter: grayscale(1); width: auto; height: auto; max-width: 100%; max-height: 2.15rem; display: block; }
  .client-list img[src$="newutility.png"] { max-height: 2.75rem; }
  .client-list img[src$="boston.png"] { width: 100%; }
  .client-marquee:focus-visible { outline: 2px solid #163df5; outline-offset: 3px; }
  @media (hover: hover) {
    .client-list img:hover { filter: grayscale(0); }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .client-marquee { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); }
    .client-marquee .client-list[aria-hidden="true"] { display: flex; }
    .client-marquee .client-track { animation: client-scroll 35s linear infinite; }
    .client-marquee:hover .client-track, .client-marquee:focus-visible .client-track { animation-play-state: paused; }
  }
  @keyframes client-scroll { to { transform: translateX(-50%); } }
  @media (max-width: 560px) {
    .hero-nav { grid-template-columns: 1fr auto; border-radius: 1.4rem; }
    .hero-nav nav { grid-row: 2; grid-column: 1 / -1; padding-bottom: .3rem; }
    .nav-cta { grid-area: 1 / 2; }
    .hero-copy { padding-top: 2rem; }
    h1 { font-size: clamp(2.05rem, 8.7vw, 3.25rem); }
    .art { margin-top: 0; height: clamp(12rem, 59vw, 18rem); }
    .service-links a { padding: .45rem .58rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .button { transition: none; }
  }
</style>

<script>
  import gsap from 'gsap';

  const hero = document.querySelector('[data-hero]');
  if (hero) {
    const media = gsap.matchMedia(hero);
    media.add('(prefers-reduced-motion: no-preference)', () => {
      gsap.timeline({ defaults: { ease: 'power2.out' } })
        .from('.hero-copy h1, .hero-copy p, .actions', { y: 8, duration: 0.48, stagger: 0.06 }, 0)
        .from('.art-image', { y: 15, scale: 1.025, opacity: 0.7, duration: 0.95 }, 0)
        .fromTo('.light', { xPercent: -65, opacity: 0 }, { xPercent: 65, opacity: 0.75, duration: 1.55, ease: 'sine.inOut' }, 0.37)
        .to('.light', { opacity: 0, duration: 0.25 }, '>-0.25');
    });
  }
</script>
