---
import { sitePath } from '../../utils/site-path';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Services" description="Explore JoomDev’s website, ecommerce, app development, CRM, AI, and automation services.">
  <h1>Services</h1>
  <section id="web">
    <h2>Web design &amp; ecommerce</h2>
    <p>Design a new site, rebuild an existing one, or develop an online store. We work with WordPress, Joomla, and ecommerce platforms.</p>
  </section>
  <section id="apps">
    <h2>App development</h2>
    <p>Build a web or mobile app for your customers or for the people who run your business.</p>
  </section>
  <section id="systems">
    <h2>CRM, AI &amp; automation</h2>
    <p>Connect your CRM and business tools, automate manual processes, or integrate AI into existing workflows.</p>
    <a href={sitePath('/services/ai-integration/')}>Explore AI integration</a>
  </section>
</BaseLayout>
