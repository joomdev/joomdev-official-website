<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const video = document.querySelector<HTMLAnchorElement>('.video-trigger');
  video?.addEventListener('click', (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    const player = document.createElement('iframe');
    player.src = 'https://www.youtube-nocookie.com/embed/iJj0ajslBbw?autoplay=1';
    player.title = 'Tanesha Owens on working with JoomDev';
    player.allow = 'autoplay; encrypted-media; picture-in-picture';
    player.allowFullscreen = true;
    video.replaceWith(player);
    player.focus();
  });

  gsap.registerPlugin(ScrollTrigger);
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll('[data-home-reveal]').forEach((group) => {
      ScrollTrigger.create({
        trigger: group,
        start: 'top 92%',
        once: true,
        onEnter: () => gsap.from(group.children, {
          y: 12, opacity: .82, duration: .45, stagger: .05, ease: 'power2.out', clearProps: 'transform,opacity',
        }),
      });
    });
  });

</script>
