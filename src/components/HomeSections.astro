---
import IndustryIllustration from './IndustryIllustration.astro';
const services = [
  { title: 'Web & Ecommerce', description: 'Build or rebuild your website, launch a store, and give your team a site it can manage.', href: '/services/#web', detail: 'WordPress · Joomla · Ecommerce' },
  { title: 'App Development', description: 'Create a web or mobile app for your customers or your team.', href: '/services/#apps', detail: 'Web apps · Mobile apps' },
  { title: 'AI Development', description: 'Put AI to work inside the products and systems you already use.', href: '/services/ai-integration/', detail: 'Consulting · Agents · Integration' },
  { title: 'CRM & Automation', description: 'Connect your CRM, internal tools, and day-to-day workflows.', href: '/services/#systems', detail: 'Low-code · CRM · Process automation' },
  { title: 'Cloud & Data', description: 'Plan your AWS setup and turn operational data into reporting your team can use.', href: 'https://www.joomdev.com/services/aws-cloud-consulting-services/', detail: 'AWS · Data science · BI' },
];
const projectBase = 'https://www.joomdev.com/case-studies/';
const projects = [
  { name: 'The New Utility', category: 'Web Development', title: 'A clearer website for a solar installer', detail: 'A redesign that makes it easier to explore solar options and request an estimate.', visual: 'solar', image: '/work/new-utility.jpg', slug: 'transformed-the-new-utilitys-website' },
  { name: 'Juice Financial', category: 'App Development', title: 'A simpler way for employers to pay their teams', detail: 'An app for inviting, enrolling, and paying employees from one place.', visual: 'juice', image: 'https://www.joomdev.com/wp-content/uploads/2023/05/juice-landing-img-2.png', slug: 'juice-finance' },
  { name: 'Surv', category: 'CRM & Integrations', title: 'Connected communication and job data', detail: 'GoHighLevel, Housecall Pro, and Aircall brought into a connected workflow.', visual: 'surv', image: '', slug: 'transforming-communication-automation-data-syncing-for-wesurv' },
  { name: 'Infinity Energy', category: 'Workflow Automation', title: 'More prospects showed up for appointments', detail: 'Automatic confirmations and reminders helped raise the appointment show-up rate from 60% to 85%.', visual: 'infinity', image: '', slug: 'transformed-infinity-energys-sales-pipeline' },
  { name: 'SolarDynamite', category: 'Lead Automation', title: 'Eight hours saved every week', detail: 'Lead data moves from GoHighLevel to Google Sheets without manual copying.', visual: 'dynamite', image: '', slug: 'how-solardynamite-saved-8-hours-weekly-with-automation' },
  { name: 'Lead Reactivation', category: 'GoHighLevel', title: 'A second chance for 8,000+ dormant leads', detail: 'A GoHighLevel setup built to nurture and re-engage an existing lead database.', visual: 'reactivation', image: '', slug: 'how-joomdev-engineered-a-high-performance-gohighlevel-ecosystem-to-reactivate-8000-leads' },
];
const platformRows = [
  [
    ['WordPress', 'wordpress.org'], ['Joomla', 'joomla.org'], ['Shopify', 'shopify.com'],
    ['WooCommerce', 'woocommerce.com'], ['GoHighLevel', 'gohighlevel.com'],
    ['Salesforce', 'salesforce.com'], ['HubSpot', 'hubspot.com'], ['Zoho', 'zoho.com'],
    ['Databricks', 'databricks.com'], ['Snowflake', 'snowflake.com'],
    ['MoEngage', 'moengage.com'], ['Boomi', 'boomi.com'],
    ['Docker', 'docker.com'], ['Oracle', 'oracle.com'],
  ],
  [
    ['Quickbase', 'quickbase.com'], ['Caspio', 'caspio.com'], ['Smartsheet', 'smartsheet.com'],
    ['Follow Up Boss', 'followupboss.com'], ['Zapier', 'zapier.com'], ['n8n', 'n8n.io'],
    ['Make', 'make.com'], ['Pipedream', 'pipedream.com'], ['AWS', 'aws.amazon.com'],
    ['Red Hat', 'redhat.com'], ['Sabre', 'sabre.com'], ['Stripe', 'stripe.com'],
    ['Cloudinary', 'cloudinary.com'], ['OpenAI', 'openai.com'],
  ],
];
const highLevelBadges = [
  ['ai-voice', 'AI Voice'],
  ['automated-swag-store', 'Automated Swag Store'],
  ['course-creator', 'Course Creator'],
  ['local-hero', 'Local Hero'],
  ['paid-ads', 'Paid Ads'],
  ['sm-manager', 'Social Media Manager'],
  ['funnel-builder', 'Funnel Builder'],
  ['ai-tech', 'AI Tech'],
  ['hipaa', 'HIPAA Training'],
];
const serviceDiagrams = [
  ['Website', 'Product catalog', 'Checkout'],
  ['Mobile app', 'Account', 'Notifications'],
  ['Customer request', 'AI assistant', 'Team handoff'],
  ['Lead capture', 'CRM', 'Follow-up'],
  ['Cloud storage', 'Data pipeline', 'Reporting'],
];
// Stock photos are used under https://www.pexels.com/license/.
const industries = [
  { name: 'Energy & Solar', photo: 'energy-solar.webp', title: 'From solar inquiry to booked consultation', copy: 'Make services easy to understand, capture inquiries, and send appointment reminders from the same workflow.', link: projects[0].slug },
  // https://www.pexels.com/photo/4386431/
  { name: 'Financial Services', photo: 'financial-services.webp', title: 'Simplify complex financial workflows', copy: 'Build clear onboarding flows and tools that help teams manage applications, enrollment, and payments.', link: projects[1].slug },
  // https://www.pexels.com/photo/8005368/
  { name: 'Home & Field Services', photo: 'home-field-services.webp', title: 'Connect customer calls to work in the field', copy: 'Give office and field teams a shared view of inquiries, bookings, and job updates.', link: projects[2].slug },
  // https://www.pexels.com/photo/256395/
  { name: 'Education', photo: 'education.webp', title: 'Make enrollment easier to navigate', copy: 'Help prospective students find program information and give staff a clear way to follow up on inquiries.' },
  // https://www.pexels.com/photo/264636/
  { name: 'Retail & Ecommerce', photo: 'retail-ecommerce.webp', title: 'Make it easier to buy and order again', copy: 'Build a storefront that connects product discovery, checkout, and order updates.' },
  // https://www.pexels.com/photo/7089401/
  { name: 'Healthcare & Wellness', photo: 'healthcare-wellness.webp', title: 'Make it easier for patients to reach your team', copy: 'Improve how patients find services and request appointments, with clear follow-up for front-office staff.' },
  // https://www.pexels.com/photo/106399/
  { name: 'Real Estate', photo: 'real-estate.webp', title: 'Turn property inquiries into conversations', copy: 'Connect listing pages and inquiry forms to your CRM so agents can follow up with the right context.' },
  // https://www.pexels.com/photo/3184292/
  { name: 'Professional Services', photo: 'professional-services.webp', title: 'Give client intake a clear next step', copy: 'Route new inquiries to the right team and give clients a straightforward way to schedule a consultation.' },
  // https://www.pexels.com/photo/546819/
  { name: 'SaaS & Technology', photo: 'saas-technology.webp', title: 'Help users get to value sooner', copy: 'Build onboarding and product integrations that help users connect their tools and get started.' },
  // https://www.pexels.com/photo/4481259/
  { name: 'Logistics & Distribution', photo: 'logistics-distribution.webp', title: 'Keep customers up to date on orders', copy: 'Bring order status and customer notifications together so teams can handle exceptions faster.' },
];
const testimonials = [
  { before: 'We could not be more pleased with', highlight: 'the kind of services that JoomDev had provided us', after: '', name: 'Achilles Tzoulafis', attribution: 'Infinity Solar Systems', source: 'https://www.joomdev.com/' },
  { before: '', highlight: 'Their attention doesn’t stop after project completion', after: '', name: 'Matthew Hildebrand', attribution: 'Infinity Roofing', source: 'https://www.joomdev.com/' },
  { before: '', highlight: 'The team brought our ideas to life', after: ' and created the customized application that we only imagined in our minds.', name: 'Alex Shvarts', attribution: 'FundKite', source: 'https://www.joomdev.com/services/mobile-app-development-services/' },
  { before: 'They delivered the project on time and all migration get done', highlight: 'without any data loss and site downtime', after: '.', name: 'Daniel', attribution: 'Trustpilot review', source: 'https://www.joomdev.com/services/quickbase-services/' },
  { before: '', highlight: 'deep expertise in a wide range of areas', after: '.', name: 'Jason', attribution: 'Google review', source: 'https://www.joomdev.com/services/quickbase-services/' },
  { before: 'They provide templates and extensions for joomla', highlight: 'that work fine', after: ' and are coded in accordance with the rules of art.', name: 'Serge Billon', attribution: 'Trustpilot review', source: 'https://www.joomdev.com/services/smartsheet-development-services/' },
  { before: 'The increase from', highlight: 'a 60% to an 85% attendance rate', after: ' has been a game-changer for our bottom line.', name: 'Jordan Baron', attribution: 'Infinity Energy', source: 'https://www.joomdev.com/case-studies/transformed-infinity-energys-sales-pipeline/' },
];
const workflows = [
  { label: 'Follow up with website leads', steps: ['Website inquiry', 'CRM record', 'Assigned follow-up'], detail: 'Capture each inquiry, add it to your CRM, and assign the next action to the right person.' },
  { label: 'Route internal approvals', steps: ['Quickbase request', 'Approval routing', 'Team notification'], detail: 'Send a request to the right approver and let the team know when a decision is made.' },
  { label: 'Capture inbound calls', steps: ['Incoming call', 'AI receptionist', 'CRM call log'], detail: 'Capture the caller’s request and pass the details to the team that can help.' },
];
---
<section class="section shell services" aria-labelledby="service-title">
  <div class="section-head">
    <div><h2 id="service-title">Start With What You Need to Build</h2><p>A new website, a mobile app, or a better way to run your business. We can build it and connect it to the tools you already use.</p></div>
    <a href={'/services/'}>Explore all services <span aria-hidden="true">↗</span></a>
  </div>
  <nav class="story-path" aria-label="Explore the homepage">
    <a href="#service-title">What we build</a>
    <a href="#workflow-title">How it connects</a>
    <a href="#industries-title">Explore industries</a>
  </nav>
  <ul class="service-grid" data-home-reveal>
    {services.map(({ title, description, href, detail }, i) => (
      <li class:list={{ featured: i === 0 }}>
        <a href={href}>
          <span class="detail">{detail}</span>
          <h3>{title}</h3><p>{description}</p>
          <div class:list={['service-art', `service-art-${i}`]} aria-hidden="true">
            {i === 0 && <div class="browser-chrome"><i></i><i></i><i></i></div>}
            {i === 1 && <div class="phone-camera"></div>}
            {serviceDiagrams[i].map((step) => <span>{step}</span>)}
            {i === 4 && <div class="mini-chart"><i></i><i></i><i></i><i></i><i></i></div>}
          </div>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>
</section>
<section class="section platform-section" aria-labelledby="platform-title">
  <div class="shell">
    <div class="section-head"><div><h2 id="platform-title">Bring the Tools You Already Use</h2><p>Start with your website, CRM, or internal tools. We’ll help connect what you have and build what’s missing.</p></div></div>
    <div class="logo-rows">
      {platformRows.map((platforms, index) => (
        <div class:list={['logo-window', { reverse: index === 1 }]} tabindex="0" aria-label={`Platform logos, row ${index + 1}`}>
          <div class="logo-track">
            {[false, true].map((duplicate) => (
              <ul class="logo-list platform-list" aria-hidden={duplicate || undefined}>
                {platforms.map(([name, domain]) => (
                  <li>
                    <img src={`https://www.google.com/s2/favicons?domain=${domain}&sz=64`} alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer" />
                    <span>{name}</span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<section class="section workflow" aria-labelledby="workflow-title">
  <div class="shell">
    <div class="section-head">
      <div><h2 id="workflow-title">How Your Tools Work Together</h2><p>See what happens after a form is submitted, a request is sent, or a customer calls.</p></div>
      <a class="story-next" href="#work-title">See Real Client Projects <span aria-hidden="true">↓</span></a>
    </div>
    <div class="workflow-scenarios" data-home-reveal>
      {workflows.map(({ label, steps, detail }) => (
        <article class="scenario">
          <h3>{label}</h3>
          <ol aria-label={label}>{steps.map((step) => <li><span aria-hidden="true"></span>{step}</li>)}</ol>
          <p>{detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<section class="section industries" aria-labelledby="industries-title">
  <div class="shell">
    <div class="section-head"><div><h2 id="industries-title">Built Around the Way Your Industry Works</h2><p>Explore what JoomDev can build for your industry, from customer-facing websites and apps to the systems behind them.</p></div></div>
    <div class="industry-picker">
      {industries.map(({ name, photo, title, copy, link }, index) => (
        <details name="home-industry" open={index === 0} style={`--industry-row:${index + 1}`}>
          <summary>{name}<span aria-hidden="true">↗</span></summary>
          <div class="industry-panel">
            <div class="industry-illustration" aria-hidden="true">
              <img src={`/industries/${photo}`} alt="" loading="lazy" decoding="async" />
              <div class="industry-badge"><IndustryIllustration industry={index} /></div>
            </div>
            <div class="industry-copy"><h3>{title}</h3><p>{copy}</p>
              <a href={link ? projectBase + link + '/' : '/contact/'}>{link ? 'Read the Case Study' : 'Discuss a Project'} <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<section class="section work" aria-labelledby="work-title">
  <div class="shell">
    <div class="section-head">
      <div><h2 id="work-title">What We Built and What Changed</h2><p>See how clients improved their websites, connected their systems, and took manual work out of their day.</p></div>
      <a href={projectBase}>View All Case Studies <span aria-hidden="true">↗</span></a>
    </div>
    <div class="project-gallery" data-home-reveal>
      {projects.map(({ name, category, title, detail, visual, image, slug }) => (
        <article>
          <a class="project-link" href={projectBase + slug + '/'} aria-label={name + ': ' + title}>
            <div class:list={['project-art', visual]} aria-hidden="true">
              {image ? <img src={image} alt="" width="640" height="360" loading="lazy" /> :
                visual === 'surv' ? <div class="surv-art"><img src={'/clients/wesurv.svg'} width="126" height="36" alt="" loading="lazy" /><span></span><span></span><span></span></div> :
                <strong>{visual === 'infinity' ? '60% → 85%' : visual === 'dynamite' ? '8 hrs / week' : '8,000+'}</strong>}
            </div>
            <div class="project-copy"><p class="project-meta"><span>{category}</span><strong>{name}</strong></p><h3>{title}</h3><p>{detail}</p><span class="case-link">Read Case Study <span aria-hidden="true">↗</span></span></div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
<section class="section testimonials" aria-labelledby="testimonials-title">
  <div class="shell">
    <div class="section-head"><div><h2 id="testimonials-title">Client Stories. <em>In Their Own Words.</em></h2><p>Trusted by 120+ businesses across industries and platforms. Here’s what a few of those teams say about working with JoomDev.</p></div></div>
    <div class="testimonial-grid">
      <article class="video-story">
        <div class="video-stage" data-testimonial-player>
          <a class="video-trigger" href="https://www.youtube.com/watch?v=iJj0ajslBbw">
            <img src={'/proof/tanesha-owens.jpg'} alt="" width="800" height="450" loading="lazy" />
            <span class="video-play"><span aria-hidden="true">▶</span> Watch Testimonial</span>
          </a>
        </div>
        <div class="video-credit"><h3>Tanesha Owens</h3><p>Founder, All About You Advocates</p><a href="https://www.youtube.com/watch?v=iJj0ajslBbw">Watch on YouTube <span aria-hidden="true">↗</span></a></div>
      </article>

      {testimonials.map(({ before, highlight, after, name, attribution, source }) => (
        <figure class="quote-tile">
          <blockquote cite={source}>“{before && before + ' '}<mark>{highlight}</mark>{after}”</blockquote>
          <figcaption><a href={source}>{name}</a><span>{attribution}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<section class="section shell credentials" aria-labelledby="credentials-title">
  <div class="section-head">
    <div><h2 id="credentials-title">Certifications &amp; Platform Credentials</h2><p>Explore our team’s HighLevel credentials, from AI voice and funnel building to campaign setup, alongside our other published platform badges.</p></div>
  </div>
  <div class="logo-rows">
    <div class="logo-window" tabindex="0" aria-label="Credential logos">
      <div class="logo-track">
        {[false, true].map((duplicate) => (
          <ul class="logo-list credential-list" aria-hidden={duplicate || undefined}>
            <li><img src={'/proof/highlevel-admin.png'} alt="HighLevel Certified Admin" width="176" height="176" loading="lazy" /></li>
            {highLevelBadges.map(([file, name]) => <li><img src={`https://ghlhero.com/wp-content/uploads/2026/08/${file}.webp`} alt={`HighLevel ${name} badge`} width="128" height="128" loading="lazy" /></li>)}
            <li><img src={'/proof/partner-1.jpg'} alt="Moodle" width="176" height="100" loading="lazy" /></li>
            <li><img src={'/proof/partner-2.jpg'} alt="Joomla Solution Developer" width="176" height="100" loading="lazy" /></li>
            <li><img src={'/proof/partner-3.jpg'} alt="Bing Ads Accredited Professional" width="176" height="100" loading="lazy" /></li>
            <li><img src={'/proof/partner-4.jpg'} alt="Google Partner" width="176" height="100" loading="lazy" /></li>
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>
<section class="section contact" aria-labelledby="contact-title">
  <div class="shell">
    <div class="contact-intro">
      <h2 id="contact-title">What’s getting in the way of <em>your next project?</em></h2>
      <ul>
        <li>Your website has outgrown what it was built to do.</li>
        <li>You have an app idea and need a practical first release.</li>
        <li>Your team keeps moving the same data between tools.</li>
        <li>You want to use AI in a workflow you already rely on.</li>
      </ul>
    </div>
    <div class="contact-panel">
      <p>Tell us what you’re trying to change. We’ll talk through what to tackle first and which tools can help.</p>
      <a class="contact-link" href={'/contact/'}>Discuss Your Project <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<style>
  .shell { width: min(73rem, calc(100% - 2.5rem)); margin-inline: auto; }
  .section { padding-block: clamp(3rem, 6.4vw, 5.75rem); }
  .section-head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 1rem; margin-bottom: clamp(1.6rem, 4vw, 3rem); }
  h2, h3, p { margin: 0; }
  h2 { font-size: clamp(1.95rem, 3.25vw, 3.15rem); letter-spacing: -.027em; font-weight: 620; line-height: 1.12; text-wrap: balance; }
  h3 { font-size: clamp(1.2rem, 1.85vw, 1.75rem); line-height: 1.2; letter-spacing: -.018em; }
  h2 + p, h3 + p { margin-top: .7rem; }
  a { text-underline-offset: .25em; }
  .section-head > a { font-size: .9rem; font-weight: 700; white-space: nowrap; }
  h2[id] { scroll-margin-top: 1.25rem; }
  .section-head p { color: #425574; max-width: 56ch; }
  .story-path { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .5rem; padding: .7rem 0 1.1rem; margin-bottom: .7rem; }
  .story-path a { position: relative; padding: .9rem .15rem 0; color: #244890; border-top: 1px solid #b7c9eb; font-size: .86rem; font-weight: 650; text-decoration: none; }
  .story-path a::before { content: ''; position: absolute; top: -.23rem; left: .15rem; width: .4rem; height: .4rem; border-radius: 50%; background: #395fcb; box-shadow: 0 0 0 4px #e7eeff; }
  .story-path a:hover { text-decoration: underline; }
  .service-grid { display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: .8rem; list-style: none; padding: 0; margin: 0; }
  .service-grid li { grid-column: span 2; display: flex; border: 1px solid #dce5f4; border-radius: 1.35rem; background: #f3f6ff; overflow: hidden; }
  .service-grid li:nth-child(2) { grid-column: span 2; background: #ecf2ff; }
  .service-grid a { display: flex; flex-direction: column; justify-content: end; position: relative; isolation: isolate; box-sizing: border-box; width: 100%; min-height: 14rem; padding: 1.4rem 2rem 1.4rem 1.4rem; text-decoration: none; color: inherit; }
  .service-grid a:focus-visible { outline-offset: -5px; }
  .service-grid .featured { grid-column: span 4; background: radial-gradient(ellipse at 90% -10%,#3054c5,#0c1839 72%); color: #fff; border-color: transparent; }
  .service-grid .featured a, .service-grid li:nth-child(2) a { min-height: clamp(16rem, 30vw, 22rem); }
  .service-grid .featured h3 { font-size: clamp(1.65rem, 3.15vw, 2.65rem); }
  .service-grid .featured p { color: #d6e2ff; max-width: 37ch; }
  .service-grid .featured .detail { color: #b8d1ff; }
  .detail { display: block; margin-bottom: .65rem; color: #405785; font-size: .78rem; font-weight: 680; }
  .arrow { display: grid; place-items: center; position: absolute; top: 1rem; right: 1rem; width: 2rem; aspect-ratio: 1; border: 1px solid currentColor; border-radius: 50%; transition: transform .25s; }
  .service-grid a:hover .arrow { transform: rotate(12deg); }
  .service-art { order: -1; margin: 0 0 auto; display: grid; align-content: center; gap: .4rem; min-height: 8rem; padding-block: .65rem 1.35rem; }
  .service-art span { display: block; width: min(100%,15rem); box-sizing: border-box; padding: .45rem .7rem; border-radius: .45rem; background: #fff; border: 1px solid #d5e0f9; color: #193971; font-size: .76rem; font-weight: 650; transition: transform .25s ease; }
  .service-art span:nth-child(2) { margin-left: 8%; background: #dfebff; }
  .service-art span:nth-child(3) { margin-left: 16%; }
  .service-grid a:hover .service-art span:nth-child(2) { transform: translateX(.4rem); }
  .featured .service-art { width: min(100%,27rem); align-self: end; }
  .service-grid li:nth-child(2) .service-art span { width: 80%; }
  .service-grid li:nth-child(3) { background: #dfeafa; }
  .service-grid li:nth-child(4) { background: #eff0ff; }
  .industries { background: #0a142c; color: #f7faff; }
  .industries .section-head p { color: #c6d4ef; }
  .industry-picker { position: relative; min-height: 27rem; }
  .industry-picker summary { display: flex; align-items: center; justify-content: space-between; gap: .75rem; width: 30%; box-sizing: border-box; cursor: pointer; padding: 1rem; border: 1px solid transparent; border-radius: .9rem; color: #dbe6fa; font-weight: 620; list-style: none; }
  .industry-picker summary::-webkit-details-marker { display: none; }
  .industry-picker summary:hover { background: #15274a; }
  .industry-picker details[open] summary { border-color: #5278c4; background: #213d80; color: #fff; }
  .industry-panel { position: absolute; inset: 0 0 auto 34%; border-radius: 1rem; overflow: hidden; background: #142749; }
  .industry-illustration { position: relative; aspect-ratio: 3 / 1; background: #132647; overflow: hidden; }
  .industry-illustration img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .industry-illustration::after { content: ''; position: absolute; inset: 0; background: linear-gradient(25deg, #0a142c66, #0a142c1a 70%); }
  .industry-badge { position: absolute; z-index: 1; inset: auto auto .75rem .75rem; display: grid; place-items: center; width: clamp(2.75rem, 6vw, 3.5rem); aspect-ratio: 1; border: 1px solid #82aaff66; border-radius: .8rem; background: #0b1833e6; }
  .industry-copy { padding: 1.35rem; }
  .industry-copy p { color: #c6d4ef; margin: .45rem 0 .9rem; }
  .industry-copy a { color: #b8dcff; }
  @media (max-width: 760px) {
    .industry-picker { min-height: auto; }
    .industry-picker summary { width: 100%; }
