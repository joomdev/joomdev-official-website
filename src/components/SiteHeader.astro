---
import MobileMenu from './MobileMenu.astro';
import { sitePath } from '../utils/site-path';

const links = [
  { label: 'About', href: sitePath('/about-us/') },
  { label: 'Services', href: sitePath('/services/') },
  { label: 'Integrations', href: sitePath('/services/ai-integration/') },
];
const contact = sitePath('/contact/');
const currentPath = Astro.url.pathname;
---
<div class="header-gap" aria-hidden="true"></div>
<header class="site-header" data-site-header>
  <div class="header-inner wrap">
    <a class="brand" href={sitePath('/')} aria-label="JoomDev home">
      <img src={sitePath('/joomdev-logo.svg')} width="196" height="50" alt="JoomDev" />
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      {links.map(({ label, href }) => (
        <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <a class="nav-cta button button-primary" href={contact} aria-current={currentPath === contact ? 'page' : undefined}>Let’s talk <span aria-hidden="true">↗</span></a>
    <MobileMenu>
      {links.map(({ label, href }) => (
        <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>
      ))}
      <a href={contact} aria-current={currentPath === contact ? 'page' : undefined}>Let’s talk</a>
    </MobileMenu>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  if (header) {
    const updateHeader = () => header.classList.toggle('is-stuck', header.getBoundingClientRect().top <= 0);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
    window.addEventListener('resize', updateHeader);
    window.addEventListener('pageshow', updateHeader);
  }
</script>

<style>
  .header-gap { height: clamp(.8rem, 2.2vw, 2rem); }
  .site-header { position: sticky; top: 0; z-index: 5; padding-block: 0; background: transparent; color: var(--color-text-inverse); }
  .header-inner { box-sizing: border-box; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; padding: .55rem .65rem .55rem .8rem; border: 1px solid var(--color-border-inverse); border-radius: 5rem; background: #080f1fee; box-shadow: 0 .4rem 1.2rem #050b1926; }
  .site-header.is-stuck { background: var(--color-header); box-shadow: 0 1px var(--color-border-inverse), 0 .4rem 1.2rem #050b1926; }
  .is-stuck .header-inner { border-color: transparent; background: transparent; box-shadow: none; }
  .desktop-nav { --link-color: var(--color-text-inverse); --link-hover-color: var(--color-accent); justify-content: center; gap: clamp(.8rem, 3vw, 2rem); }
  a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .desktop-nav a[aria-current="page"] { --link-hover-color: var(--color-surface); --link-color: var(--color-accent); }
  .brand { display: flex; justify-self: start; padding: .36rem .65rem; border-radius: 4rem; background: var(--color-text-inverse); }
  .brand img { display: block; width: clamp(100px, 12vw, 160px); height: auto; }
  .nav-cta { justify-self: end; white-space: nowrap; }
  @media (max-width: 720px) {
    .header-inner { grid-template-columns: 1fr auto; border-radius: 1.4rem; }
    .desktop-nav, .nav-cta { display: none; }
  }
</style>
