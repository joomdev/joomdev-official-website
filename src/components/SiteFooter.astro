---
import { sitePath } from '../utils/site-path';
const serviceLinks = [
  ['/services/#web', 'Web & Ecommerce'],
  ['/services/#apps', 'App Development'],
  ['/services/ai-integration/', 'AI Integration'],
  ['/services/#systems', 'CRM & Automation'],
  ['https://www.joomdev.com/services/aws-cloud-consulting-services/', 'AWS Cloud Consulting'],
];
const companyLinks = [
  ['https://www.joomdev.com/about-us/', 'About JoomDev'],
  ['https://www.joomdev.com/career/', 'Careers'],
  ['https://www.joomdev.com/partners/', 'Partners'],
  ['/contact/', 'Contact Us'],
];
const resources = [
  ['https://www.joomdev.com/blog/', 'Blog'],
  ['https://www.joomdev.com/case-studies/', 'Case Studies'],
  ['https://www.joomdev.com/tools/', 'Free Tools'],
];
const policies = [
  ['/sitemap/', 'Sitemap'],
  ['https://www.joomdev.com/privacy-policy/', 'Privacy Policy'],
  ['https://www.joomdev.com/terms-and-conditions/', 'Terms & Conditions'],
  ['https://www.joomdev.com/privacy-policy/#:~:text=Cookies', 'Cookies Policy'],
];
---
<footer class="footer">
  <div class="footer-wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={sitePath('/')} aria-label="JoomDev home"><img src={sitePath('/joomdev-logo.svg')} width="157" height="40" alt="JoomDev" loading="lazy" /></a>
        <p>Websites, apps, and business systems built to work together.</p>
      </div>
      <nav aria-label="Footer services">
        <h2>Services</h2><ul>{serviceLinks.map(([href,label]) => <li><a href={sitePath(href)}>{label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Footer company">
        <h2>Company</h2><ul>{companyLinks.map(([href,label]) => <li><a href={sitePath(href)}>{label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Footer resources">
        <h2>Resources</h2><ul>{resources.map(([href,label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>
      <div class="footer-contact">
        <h2>Talk to Us</h2>
        <ul><li><a href="mailto:info@joomdev.com">info@joomdev.com</a></li><li><a href="tel:+18662761994">+1 (866) 276-1994</a></li></ul>
        <div class="footer-social">
          <a href="https://www.linkedin.com/company/joomdev-corporation/" aria-label="JoomDev on LinkedIn"><span aria-hidden="true">in</span></a>
          <a href="https://github.com/joomdev" aria-label="JoomDev on GitHub"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.49c-2.23.48-2.7-.95-2.7-.95-.36-.92-.89-1.16-.89-1.16-.73-.5.05-.49.05-.49.81.06 1.24.83 1.24.83.72 1.23 1.89.88 2.35.67.07-.52.28-.88.51-1.08-1.78-.21-3.65-.89-3.65-3.96 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.28.82 2.15 0 3.08-1.88 3.75-3.67 3.95.29.25.54.74.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg></a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <small>© {new Date().getFullYear()} JoomDev. All rights reserved.</small>
      <nav aria-label="Footer policies"><ul>{policies.map(([href,label]) => <li><a href={sitePath(href)}>{label}</a></li>)}</ul></nav>
    </div>
  </div>
</footer>
<style>
  .footer { background: radial-gradient(ellipse at 12% 0,#192f66,#080f21 58%); color: #e7efff; }
  .footer-wrap { width: min(73rem,calc(100% - 2.5rem)); margin-inline: auto; padding-top: clamp(2rem,5vw,3.75rem); }
  .footer-grid { display: grid; grid-template-columns: 1.25fr 1.05fr .72fr .8fr 1fr; gap: 1.5rem; padding-bottom: 2rem; }
  nav { display: block; }
  h2 { margin: 0 0 .8rem; font-size: .95rem; font-weight: 700; color: #fff; }
  a { color: #c8d7f0; text-decoration: none; overflow-wrap: anywhere; }
  a:hover { color: #fff; text-decoration: underline; }
  a:focus-visible { outline-color: #b5ddff; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .42rem; }
  p, li, .footer-contact a { font-size: .9rem; }
  .footer-brand p { max-width: 25ch; margin-top: .8rem; color: #c8d7f0; }
  .footer-brand a { display: inline-flex; background: #f8faff; padding: .4rem .65rem; border-radius: .4rem; }
  .footer-brand img { display: block; width: 8.5rem; height: auto; }
  .footer-bottom { display: flex; justify-content: space-between; align-items: center; gap: .5rem; border-top: 1px solid #2a3b59; padding-block: 1rem; font-size: .84rem; }
  .footer-bottom nav ul { display: flex; flex-wrap: wrap; gap: .35rem 1rem; }
  .footer-bottom { flex-wrap: wrap; }
  .footer-social { display: flex; gap: .45rem; margin-top: .7rem; }
  .footer-social a { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid #5b719e; border-radius: 50%; font-weight: 700; }
  @media (max-width: 850px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 440px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
