<details class="mobile-menu">
  <summary>
    <span class="menu-icon" aria-hidden="true"></span>
    <span class="menu-label">Menu</span>
  </summary>
  <nav aria-label="Primary">
    <slot />
  </nav>
</details>

<style>
  .mobile-menu { display: none; }

  @media (max-width: 720px) {
    .mobile-menu { position: relative; z-index: 2; display: block; color: var(--color-text-inverse); }
    summary { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: .75rem; background: #122540; list-style: none; cursor: pointer; }
    summary::-webkit-details-marker { display: none; }
    summary:focus-visible, nav :global(a:focus-visible) { outline: 2px solid #80a8cb; outline-offset: 2px; }
    .menu-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .menu-icon { position: relative; width: 1.25rem; height: 2px; background: currentColor; }
    .menu-icon::before, .menu-icon::after { content: ''; position: absolute; inset: 0; background: currentColor; }
    .menu-icon::before { transform: translateY(-6px); }
    .menu-icon::after { transform: translateY(6px); }
    [open] .menu-icon { background: transparent; }
    [open] .menu-icon::before { transform: rotate(45deg); }
    [open] .menu-icon::after { transform: rotate(-45deg); }
    nav { position: absolute; top: calc(100% + .5rem); right: 0; display: grid; gap: .2rem; min-width: 11rem; padding: .45rem; border: 1px solid var(--color-border-inverse); border-radius: .85rem; background: var(--color-header); box-shadow: 0 .65rem 1.5rem #0004; }
    nav :global(a) { --link-hover-color: var(--color-accent); display: flex; align-items: center; min-height: 2.75rem; padding-inline: .75rem; border-radius: .45rem; color: inherit; text-decoration: none; }
    nav :global(a:hover) { background: #122540; }
    nav :global(a[aria-current="page"]) { --link-hover-color: var(--color-surface); background: #122540; color: var(--color-accent); }
  }
</style>
