---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  immersive?: boolean;
}

const { title, description, noindex = false, immersive = false } = Astro.props;
const indexable = process.env.SITE_INDEXABLE === 'true' && !noindex;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | JoomDev</title>
    <meta name="description" content={description} />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
  </head>
  <body class:list={{ 'dark-intro': immersive }}>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <main class:list={immersive ? 'immersive' : 'wrap'} id="content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  :global(html) { scroll-padding-top: 7rem; }
  .dark-intro { background: linear-gradient(var(--color-hero) 0 10rem, var(--color-surface) 10rem); }
  .immersive { padding: 0; }
  .skip-link:focus { position: fixed; z-index: 6; top: .75rem; left: .75rem; background: var(--color-surface); padding: .5rem .75rem; }
</style>
