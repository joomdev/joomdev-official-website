---
import { sitePath } from '../utils/site-path';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  immersive?: boolean;
}

const { title, description, noindex = false, immersive = false } = Astro.props;
const indexable = process.env.SITE_INDEXABLE === 'true' && !noindex;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | JoomDev</title>
    <meta name="description" content={description} />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    {!immersive && <header class="site-header">
      <div class="wrap navigation">
        <a class="brand" href={sitePath('/')}>JoomDev</a>
        <nav aria-label="Main navigation">
          <a href={sitePath('/services/')}>Services</a>
          <a href={sitePath('/contact/')}>Contact</a>
        </nav>
      </div>
    </header>}
    <main class:list={immersive ? "immersive" : "wrap"} id="content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
